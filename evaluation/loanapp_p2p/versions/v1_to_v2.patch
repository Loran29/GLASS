+def _role_tokens(text: str) -> list[str]:
+    """Lower-case words with a plural 's' dropped ("Field agents" -> field, agent)."""
+    return [w[:-1] if len(w) > 3 and w.endswith("s") else w for w in re.findall(r"[a-z0-9]+", text.lower())]
