+def _seconds_of_day(text: Any) -> float:
+    """'HH:MM:SS[.fff]' -> seconds; an end of 23:59:59 or later counts as the full day."""
+    h, m, s = (str(text).split(":") + ["0", "0"])[:3]
+    sec = int(h) * 3600 + int(m) * 60 + float(s)
+    return 86400.0 if sec >= 86399 else sec
